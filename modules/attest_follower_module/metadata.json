{
  "name": "attest_follower_module",
  "display_name": "beacon-veil attest follower",
  "version": "0.1.0",
  "type": "core",
  "interface": "cdylib",
  "category": "wallet",
  "description": "Supervises attest-followerd, which keeps a beacon-veil Ethereum light-client instance on LEZ current. Beacon data comes from beacon_api_module.",
  "main": "attest_follower_module_plugin",
  "dependencies": ["beacon_api_module"],
  "codegen": {
    "rust": { "crate": "rust-lib", "trait": "AttestFollowerModule", "source": "src/glue.rs" }
  },
  "nix": {
    "packages": { "build": [], "runtime": [] },
    "external_libraries": [],
    "cmake": { "find_packages": [], "extra_sources": [], "extra_include_dirs": [], "extra_link_libraries": [] }
  }
}
