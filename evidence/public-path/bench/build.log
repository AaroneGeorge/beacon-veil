## Dockerfile (docker builds)
FROM risczero/risc0-guest-builder:r0.1.91.1 as build
WORKDIR /src
COPY . .
ENV CARGO_ENCODED_RUSTFLAGS="-C^_passes=lower-atomic^_-C^_link-arg=-Ttext=0x00200800^_-C^_link-arg=--fatal-warnings^_-C^_panic=abort^_--cfg^_getrandom_backend=\"custom\""
ENV CARGO_TARGET_DIR="target"
ENV RISC0_FEATURE_bigint2=""
ENV CC_riscv32im_risc0_zkvm_elf="/root/.risc0/cpp/bin/riscv32-unknown-elf-gcc"
ENV CFLAGS_riscv32im_risc0_zkvm_elf="-march=rv32im -nostdlib"
RUN cargo +risc0 fetch --locked --target riscv32im-risc0-zkvm-elf --manifest-path guests/bls_bench/Cargo.toml
RUN mkdir -p /out && CARGO_MANIFEST_PATH=guests/bls_bench/Cargo.toml CARGO_BUILD_JOBS=4 \
    cargo +risc0 build --release --locked --target riscv32im-risc0-zkvm-elf --manifest-path guests/bls_bench/Cargo.toml --bin bls_bench && \
    cp target/riscv32im-risc0-zkvm-elf/release/bls_bench /out/

FROM scratch as export
COPY --from=build /out /
